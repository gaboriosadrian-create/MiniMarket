# Firebase Configuration for Minimarket Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Set to 'true' to enable demo data seeding in production builds
VITE_ENABLE_DEMO_SEED=

# GEMINI_API_KEY: Required if Gemini AI features are used.
GEMINI_API_KEY=

# APP_URL: The URL where this application is hosted.
APP_URL=
