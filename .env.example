# Firebase Configuration for Minimarket Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Set to 'true' to enable demo data seeding in production builds
VITE_ENABLE_DEMO_SEED=

# GEMINI_API_KEY: Required if Gemini AI features are used.
GEMINI_API_KEY=

# APP_URL: The URL where this application is hosted.
APP_URL=

# Firebase App Check (reCAPTCHA v3 or reCAPTCHA Enterprise Site Key - Public)
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_IS_ENTERPRISE=true

# =========================================================================
# Mercado Pago Argentina Multi-Tenant OAuth Integration (Plataforma Uwi)
# =========================================================================
# Credenciales oficiales de la Aplicación Mercado Pago de Uwi (SOLO BACKEND)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=

# Activa la infraestructura de integración con Mercado Pago (default: false)
MERCADOPAGO_ENABLED=false

# Activa la confirmación automática server-side al recibir Webhook de pago confirmado (default: false)
MERCADOPAGO_AUTO_CONFIRM=false

# Token de Acceso privado de Mercado Pago para Sandbox / Demo (SOLO BACKEND - NUNCA EXPONER EN CLIENTE)
MERCADOPAGO_ACCESS_TOKEN=

# Identificadores opcionales de Cuenta y POS para Sandbox / Pruebas
MERCADOPAGO_USER_ID=
MERCADOPAGO_SITE_ID=MLA
MERCADOPAGO_EXTERNAL_STORE_ID=
MERCADOPAGO_EXTERNAL_POS_ID=
MERCADOPAGO_STORE_ID=
MERCADOPAGO_POS_ID=


